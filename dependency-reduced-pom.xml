<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>TrueAvarus.UNSF</groupId>
  <artifactId>UNSF</artifactId>
  <name>UNSFX</name>
  <version>1.1.1</version>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <outputDirectory>target/classes</outputDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>magiclib:org.magiclib</include>
                </includes>
              </artifactSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.lwjgl.lwjgl</groupId>
      <artifactId>lwjgl_util</artifactId>
      <version>2.9.3</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>starfarer.api</groupId>
      <artifactId>com.fs</artifactId>
      <version>0.98</version>
      <scope>system</scope>
      <systemPath>C:/Games/SS/starsector-core/starfarer.api.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>starfarer_obf</groupId>
      <artifactId>com.fs</artifactId>
      <version>0.98</version>
      <scope>system</scope>
      <systemPath>C:/Games/SS/starsector-core/starfarer_obf.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>magiclib</groupId>
      <artifactId>org.magiclib</artifactId>
      <version>1.5.7</version>
      <scope>system</scope>
      <systemPath>C:/Users/Romindous/Downloads/ss/MagicLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>lazylib</groupId>
      <artifactId>org.lazywizard</artifactId>
      <version>3.0.0</version>
      <scope>system</scope>
      <systemPath>C:/Users/Romindous/Downloads/ss/LazyLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>exerelin</groupId>
      <artifactId>exerelin</artifactId>
      <version>0.12.1b</version>
      <scope>system</scope>
      <systemPath>C:/Users/Romindous/Downloads/ss/ExerelinCore.jar</systemPath>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
