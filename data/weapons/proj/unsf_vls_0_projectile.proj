{
	"id":"unsf_vls_0_projectile",
	"specClass":"missile",
	"missileType":"MISSILE",
	"sprite":"graphics/missles/shell_small.png",
	"size":[6,14],
	"center":[3,7],
	"collisionRadius":60,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[100,100,255,220],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":20, # purely visual
	"engineSpec":{
        "maxSpeed":1000,
        "turnAcc":2000,
        "turnRate":1000,
        "acc":1200,
        "dec":1000
    },
	"engineSlots":[
	    {"id":"ES1",
		"loc":[-3, 0],
            "style":"CUSTOM",
		"styleSpec":{
			"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
			"engineColor":[255,209,0,70],
			"contrailDuration":2,
			"contrailWidthMult":1,
			"contrailWidthAddedFractionAtEnd":2.5,  # can be negative. makes trail spread out/narrow at the end
			"contrailMinSeg":5, # min segment length, in pixels
			"contrailMaxSpeedMult":0.5f,
			"contrailAngularVelocityMult":0.5f,
			"contrailColor":[150,150,150,130],
			"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
		},
        "width":6.0,
        "length":40.0,
        "angle":180.0},
    ],
    "explosionSpec":{
        "duration":0.1f, # not visual
        "radius":0,
        "coreRadius": 0, # full damage within core radius
        "collisionClass":MISSILE_NO_FF,
        "collisionClassByFighter":MISSILE_NO_FF,
        "particleSizeMin":2.0,
        "particleSizeRange":4.0,
        "particleDuration":1,
        "particleCount":20,
        "particleColor":[200,160,40,255],
        "explosionColor":[200,200,0,64],
        "useDetailedExplosion":false
    },
    "renderTargetIndicator":false,
}